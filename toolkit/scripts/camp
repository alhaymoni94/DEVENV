#!/usr/bin/env python3
"""camp — AUT Linux Camp CLI wrapper."""
import sys
from pathlib import Path

# Add camp_cli to path so imports work when run directly
_SCRIPT_DIR = Path(__file__).resolve().parent
_CAMP_DIR = _SCRIPT_DIR.parents[1]
sys.path.insert(0, str(_CAMP_DIR / "toolkit"))

from camp_cli.main import main

if __name__ == "__main__":
    sys.exit(main())
