#!/usr/bin/env bash
# cheat — Terminal stack interactive learning reference
#
# Usage:
#   cheat                     interactive TUI browser (requires fzf)
#   cheat <topic>             open a topic directly
#   cheat --list              print all available topics (plain, for scripting)
#   cheat --home              show the tools & alias quick reference
#   cheat --start             first-run interactive tour
#   cheat --quick <tool>      one-pager quick reference
#   cheat --daily             random pro tip
#   cheat --quiz <topic>      interactive self-test
#   cheat --workflow <name>   multi-tool workflow guide
#   cheat --undo <tool>       recovery guide

TOOLKIT="${TOOLKIT_DIR:-$HOME/Documents/AUT-Projects/AUT-Linux-Camp/toolkit}"
TOOLS_DIR="$TOOLKIT/cheatsheets"
WORKFLOWS_DIR="$TOOLKIT/workflows"
CONCEPTS_DIR="$TOOLKIT/concepts"
QUICKREF_DIR="$TOOLKIT/quick-ref"
UNDO_DIR="$TOOLKIT/undo-guides"
PRACTICE_DIR="$TOOLKIT/practice"
QUIZ_DIR="$PRACTICE_DIR/quizzes"

# ── Colors (Tokyo Night palette) ──────────────────────────────────────────────
BOLD="\033[1m"
CYAN="\033[1;36m"
YELLOW="\033[33m"
GREEN="\033[32m"
BLUE="\033[34m"
DIM="\033[2m"
RESET="\033[0m"

HR="${DIM}  ─────────────────────────────────────────────────────${RESET}"

# ── Render a markdown file to stdout or pager ─────────────────────────────────
_render() {
  local file="$1"
  local use_pager="${2:-true}"

  if command -v glow &>/dev/null; then
    if [[ "$use_pager" == "true" ]]; then
      glow -p "$file"
    else
      glow "$file"
    fi
  elif command -v bat &>/dev/null; then
    if [[ "$use_pager" == "true" ]]; then
      bat --style=plain --color=always "$file" | less -R
    else
      bat --style=plain --color=always "$file"
    fi
  else
    less -R "$file"
  fi
}

# ── Find the file path for a given topic name ─────────────────────────────────
_find_topic() {
  local raw="$1"
  local name="${raw#*/}"

  for dir in "$TOOLS_DIR" "$WORKFLOWS_DIR" "$CONCEPTS_DIR"; do
    [[ -f "$dir/$name.md" ]] && echo "$dir/$name.md" && return 0
  done
  return 1
}

# ── List all topics with category prefix ─────────────────────────────────────
_list_all() {
  local f
  for f in "$TOOLS_DIR"/*.md; do
    [[ -f "$f" ]] && printf "tools/%s\n" "$(basename "$f" .md)"
  done
  for f in "$WORKFLOWS_DIR"/*.md; do
    [[ -f "$f" ]] && printf "workflows/%s\n" "$(basename "$f" .md)"
  done
  for f in "$CONCEPTS_DIR"/*.md; do
    [[ -f "$f" ]] && printf "concepts/%s\n" "$(basename "$f" .md)"
  done
  for f in "$QUICKREF_DIR"/*.md; do
    [[ -f "$f" ]] && printf "quick-ref/%s\n" "$(basename "$f" .md)"
  done
  for f in "$UNDO_DIR"/*.md; do
    [[ -f "$f" ]] && printf "undo/%s\n" "$(basename "$f" .md)"
  done
}

# ── Count topics per category ─────────────────────────────────────────────────
_count() {
  local dir="$1"
  shopt -s nullglob
  local files=("$dir"/*.md)
  echo "${#files[@]}"
}

# ── Home screen ───────────────────────────────────────────────────────────────
_home() {
  printf "\n"
  printf "${CYAN}  ╔══════════════════════════════════════════════════════╗${RESET}\n"
  printf "${CYAN}  ║   Terminal Stack Reference                           ║${RESET}\n"
  printf "${CYAN}  ╚══════════════════════════════════════════════════════╝${RESET}\n\n"

  printf "${BOLD}  Tools${RESET}\n"
  printf "$HR\n"
  _row() { printf "  ${GREEN}%-14s${RESET} ${DIM}%-16s${RESET} %s\n" "$1" "$2" "$3"; }
  _row "micro"       "e <file>"    "Terminal text editor"
  _row "lazygit"     "lg"          "Git — stage, commit, push, branch, rebase"
  _row "gh-dash"     "ghd"         "GitHub PRs, issues, review requests, CI"
  _row "yazi"        "y"           "File manager with image preview"
  _row "lazydocker"  "lzd"         "Docker containers, images, logs"
  _row "btop"        "top"         "System monitor — CPU, RAM, processes"
  _row "tmux"        "(always on)" "Session manager — Prefix: Ctrl+a"
  _row "aichat"      "aichat"      "Terminal-native AI chat"
  _row "opencode"    "opencode"    "AI coding agent"
  printf "\n"

  local tools_count workflows_count concepts_count quickref_count undo_count
  tools_count="$(_count "$TOOLS_DIR")"
  workflows_count="$(_count "$WORKFLOWS_DIR")"
  concepts_count="$(_count "$CONCEPTS_DIR")"
  quickref_count="$(_count "$QUICKREF_DIR")"
  undo_count="$(_count "$UNDO_DIR")"

  printf "${BOLD}  Cheatsheets${RESET}   ${DIM}%s topics — cheat <topic>${RESET}\n" \
    "$((tools_count + workflows_count + concepts_count))"
  printf "$HR\n"

  if [[ $tools_count -gt 0 ]]; then
    printf "  ${CYAN}tools${RESET}\n"
    local i=0 f name desc
    for f in "$TOOLS_DIR"/*.md; do
      [[ -f "$f" ]] || continue
      printf "    ${YELLOW}%-18s${RESET}" "$(basename "$f" .md)"
      (( ++i % 3 == 0 )) && printf "\n"
    done
    (( i % 3 != 0 )) && printf "\n"
  fi

  if [[ $workflows_count -gt 0 ]]; then
    printf "  ${CYAN}workflows${RESET}\n"
    for f in "$WORKFLOWS_DIR"/*.md; do
      [[ -f "$f" ]] || continue
      name="$(basename "$f" .md)"
      desc="$(sed -n '2p' "$f" | sed 's/^> //')"
      printf "    ${YELLOW}%-20s${RESET} ${DIM}%s${RESET}\n" "$name" "$desc"
    done
  fi

  if [[ $concepts_count -gt 0 ]]; then
    printf "  ${CYAN}concepts${RESET}\n"
    for f in "$CONCEPTS_DIR"/*.md; do
      [[ -f "$f" ]] || continue
      name="$(basename "$f" .md)"
      desc="$(sed -n '2p' "$f" | sed 's/^> //')"
      printf "    ${YELLOW}%-20s${RESET} ${DIM}%s${RESET}\n" "$name" "$desc"
    done
  fi

  printf "\n"

  if [[ $quickref_count -gt 0 ]]; then
    printf "${BOLD}  Quick Ref${RESET}     ${DIM}%s cards — cheat --quick <tool>${RESET}\n" "$quickref_count"
    printf "$HR\n"
    for f in "$QUICKREF_DIR"/*.md; do
      [[ -f "$f" ]] || continue
      printf "    ${YELLOW}%-18s${RESET}" "$(basename "$f" .md)"
    done
    printf "\n\n"
  fi

  if [[ $undo_count -gt 0 ]]; then
    printf "${BOLD}  Undo Guides${RESET}   ${DIM}%s guides — cheat --undo <tool>${RESET}\n" "$undo_count"
    printf "$HR\n"
    for f in "$UNDO_DIR"/*.md; do
      [[ -f "$f" ]] || continue
      printf "    ${YELLOW}%-18s${RESET}" "$(basename "$f" .md)"
    done
    printf "\n\n"
  fi

  printf "${BOLD}  Usage${RESET}\n"
  printf "$HR\n"
  printf "  ${YELLOW}cheat${RESET}                 launch interactive browser
  printf "  ${YELLOW}cheat --start${RESET}       first-run interactive tour\n"
  printf "  ${YELLOW}cheat <topic>${RESET}          open a topic directly\n"
  printf "  ${YELLOW}cheat --quick <tool>${RESET}   one-pager quick reference\n"
  printf "  ${YELLOW}cheat --daily${RESET}          random pro tip\n"
  printf "  ${YELLOW}cheat --quiz <topic>${RESET}   interactive self-test\n"
  printf "  ${YELLOW}cheat --undo <tool>${RESET}    recovery guide\n"
  printf "  ${YELLOW}cheat --workflow <n>${RESET}   multi-tool workflow\n"
  printf "  ${YELLOW}cheat --list${RESET}           list all topics\n"
  printf "\n"
}

# ── Interactive TUI (fzf) ─────────────────────────────────────────────────────
_interactive() {
  if ! command -v fzf &>/dev/null; then
    _home
    return
  fi

  local selected
  selected=$(
    _list_all | fzf \
      --prompt="  › " \
      --header=$'  Terminal Stack Reference\n  ↑↓ navigate   Enter open   Ctrl+/ toggle preview   Esc quit\n' \
      --preview="\"$TOOLKIT/scripts/cheat\" --preview {}" \
      --preview-window="right:60%:wrap:rounded" \
      --border=rounded \
      --color="bg+:#1a1b26,border:#414868,header:italic:#7dcfff,prompt:#e0af68,pointer:#7dcfff,hl:#7dcfff,hl+:#7dcfff:bold" \
      --height=95% \
      --bind="ctrl-/:toggle-preview" \
      --bind="?:toggle-preview" \
      --ansi \
      2>/dev/null
  ) || true

  [[ -n "$selected" ]] && {
    local file
    file="$(_find_topic "$selected")" && _render "$file"
  }
}

# ── Quick ref mode ────────────────────────────────────────────────────────────
_cmd_quick() {
  local name="${1:-}"
  [[ -z "$name" ]] && { printf "${YELLOW}Usage: cheat --quick <tool>${RESET}\n"; exit 1; }
  local qr_file="$QUICKREF_DIR/$name.md"
  [[ -f "$qr_file" ]] && _render "$qr_file" || {
    printf "\n${YELLOW}  No quick-ref for '${name}'.${RESET}\n\n"
    printf "  Available: "
    ls "$QUICKREF_DIR/" 2>/dev/null | sed 's/.md$// ' | tr '\n' ' '
    printf "\n"
    exit 1
  }
}

# ── Daily tip mode ────────────────────────────────────────────────────────────
_cmd_daily() {
  local tips_file="$PRACTICE_DIR/daily-tips.md"
  [[ -f "$tips_file" ]] || { printf "${YELLOW}No tips file found.${RESET}\n"; exit 1; }
  local total num tip
  total=$(grep -c '^[0-9]' "$tips_file")
  num=$(( RANDOM % total + 1 ))
  tip=$(sed -n "${num}p" "$tips_file" | sed 's/^[0-9]*\. //')
  printf "\n${CYAN}  ╔══════════════════════════════════════════╗${RESET}\n"
  printf "${CYAN}  ║   Tip #%-3d                              ║${RESET}\n" "$num"
  printf "${CYAN}  ╚══════════════════════════════════════════╝${RESET}\n\n"
  printf "  ${GREEN}%s${RESET}\n\n" "$tip"
}

# ── Quiz mode ─────────────────────────────────────────────────────────────────
_cmd_quiz() {
  local topic="${1:-}"
  [[ -z "$topic" ]] && { printf "${YELLOW}Usage: cheat --quiz <topic>${RESET}\n"; exit 1; }
  local quiz_file="$QUIZ_DIR/$topic.md"
  [[ -f "$quiz_file" ]] || {
    printf "\n${YELLOW}  No quiz for '${topic}'.${RESET}\n\n"
    printf "  Available: "
    ls "$QUIZ_DIR/" 2>/dev/null | sed 's/.md$// ' | tr '\n' ' '
    printf "\n"
    exit 1
  }
  if ! command -v fzf &>/dev/null; then
    _render "$quiz_file"
    return
  fi
  local questions=() answers=() line i=0 total
  while IFS= read -r line; do
    if [[ "$line" =~ ^Q:\ (.+) ]]; then
      questions+=("${BASH_REMATCH[1]}")
    elif [[ "$line" =~ ^A:\ (.+) ]]; then
      answers+=("${BASH_REMATCH[1]}")
    fi
  done < "$quiz_file"
  total=${#questions[@]}
  printf "\n${CYAN}  ╔══════════════════════════════════════════╗${RESET}\n"
  printf "${CYAN}  ║   Quiz: %s (%d questions)                 ║${RESET}\n" "$topic" "$total"
  printf "${CYAN}  ╚══════════════════════════════════════════╝${RESET}\n\n"
  for q in "${questions[@]}"; do
    ((i++))
    printf "  ${BOLD}Q%d:${RESET} %s\n" "$i" "$q"
    printf "  ${DIM}  Press Enter to reveal answer...${RESET}"
    read -r
    printf "  ${GREEN}  A: %s${RESET}\n\n" "${answers[$((i-1))]}"
  done
  printf "  ${CYAN}Quiz complete. Run again to review.${RESET}\n\n"
}

# ── Undo guide mode ───────────────────────────────────────────────────────────
_cmd_undo() {
  local name="${1:-}"
  [[ -z "$name" ]] && { printf "${YELLOW}Usage: cheat --undo <tool>${RESET}\n"; exit 1; }
  local undo_file="$UNDO_DIR/$name.md"
  [[ -f "$undo_file" ]] && _render "$undo_file" || {
    printf "\n${YELLOW}  No undo guide for '${name}'.${RESET}\n\n"
    printf "  Available: "
    ls "$UNDO_DIR/" 2>/dev/null | sed 's/.md$// ' | tr '\n' ' '
    printf "\n"
    exit 1
  }
}

# ── Workflow mode ─────────────────────────────────────────────────────────────
_cmd_workflow() {
  local name="${1:-}"
  [[ -z "$name" ]] && {
    printf "${YELLOW}Usage: cheat --workflow <name>${RESET}\n\n"
    printf "  Available: "
    ls "$WORKFLOWS_DIR/" 2>/dev/null | sed 's/.md$// ' | tr '\n' ' '
    printf "\n"
    exit 1
  }
  local wf_file="$WORKFLOWS_DIR/$name.md"
  [[ -f "$wf_file" ]] && _render "$wf_file" || {
    printf "\n${YELLOW}  No workflow '${name}'.${RESET}\n\n"
    printf "  Available: "
    ls "$WORKFLOWS_DIR/" 2>/dev/null | sed 's/.md$// ' | tr '\n' ' '
    printf "\n"
    exit 1
  }
}

# ── First-run tour ────────────────────────────────────────────────────────────
_cmd_start() {
  local tour_file="$PRACTICE_DIR/tour.yml"
  [[ -f "$tour_file" ]] || { printf "${YELLOW}Tour file not found.${RESET}\n"; exit 1; }

  # Parse YAML manually (no yq dependency needed)
  local title intro outro
  title="$(grep '^title:' "$tour_file" | sed 's/^title: "//;s/"$//')"
  intro="$(grep '^intro:' "$tour_file" | sed 's/^intro: "//;s/"$//')"
  outro="$(grep '^outro:' "$tour_file" | sed 's/^outro: "//;s/"$//')"

  printf "\n${CYAN}  ╔══════════════════════════════════════════╗${RESET}\n"
  printf "${CYAN}  ║   %s${RESET}\n" "$title"
  printf "${CYAN}  ╚══════════════════════════════════════════╝${RESET}\n\n"
  printf "  ${DIM}%s${RESET}\n\n" "$intro"

  # Parse steps
  local step_num=0
  local in_step=false
  local step_title="" step_command="" step_desc="" step_tip=""
  local keys=()

  _render_step() {
    ((step_num++))
    printf "  ${BOLD}Step %d/5: %s${RESET}\n" "$step_num" "$step_title"
    printf "  ${DIM}  %s${RESET}\n\n" "$step_desc"
    printf "  ${GREEN}  → %s${RESET}\n\n" "$step_command"
    if [[ ${#keys[@]} -gt 0 ]]; then
      printf "  ${BOLD}  Key bindings:${RESET}\n"
      for k in "${keys[@]}"; do
        printf "  ${DIM}    %s${RESET}\n" "$k"
      done
      printf "\n"
    fi
    if [[ -n "$step_tip" ]]; then
      printf "  ${YELLOW}  💡 %s${RESET}\n\n" "$step_tip"
    fi
    if [[ $step_num -lt 5 ]]; then
      printf "  ${DIM}  Press Enter to continue...${RESET}"
      if [ -t 0 ]; then
        read -r
      else
        # Non-interactive: consume one line from stdin (the piped echo "")
        read -r < /dev/stdin 2>/dev/null || true
      fi
      printf "\n"
    fi
  }

  while IFS= read -r line; do
    # Detect step start
    if [[ "$line" == *"- title:"* ]]; then
      # Render previous step if exists
      if $in_step; then
        _render_step
      fi
      in_step=true
      step_title="${line#*- title: }"
      step_title="${step_title#\"}"
      step_title="${step_title%\"}"
      step_command=""
      step_desc=""
      step_tip=""
      keys=()
      continue
    fi
    if $in_step; then
      if [[ "$line" == *"command:"* ]]; then
        step_command="${line#*command: }"
        step_command="${step_command#\"}"
        step_command="${step_command%\"}"
      elif [[ "$line" == *"description:"* ]]; then
        step_desc="${line#*description: }"
        step_desc="${step_desc#\"}"
        step_desc="${step_desc%\"}"
      elif [[ "$line" == *"tip:"* ]]; then
        step_tip="${line#*tip: }"
        step_tip="${step_tip#\"}"
        step_tip="${step_tip%\"}"
      elif [[ "$line" == *"    - \""* ]]; then
        key="${line#*    - \"}"
        key="${key%\"}"
        keys+=("$key")
      elif [[ "$line" =~ ^[a-z] ]]; then
        # New top-level key, render last step
        _render_step
        in_step=false
      fi
    fi
  done < "$tour_file"
  # Render final step
  if $in_step; then
    _render_step
  fi

  printf "\n  ${CYAN}  %s${RESET}\n\n" "$outro"
}

# ── Main dispatch ─────────────────────────────────────────────────────────────
case "${1:-}" in
  "")
    _interactive
    ;;
  --preview)
    file="$(_find_topic "${2:-}")" 2>/dev/null \
      && _render "$file" "false" 2>/dev/null \
      || printf "${DIM}  preview unavailable${RESET}\n"
    ;;
  --list)
    _list_all
    ;;
  --home)
    _home
    ;;
  --quick)
    _cmd_quick "$2"
    ;;
  --daily)
    _cmd_daily
    ;;
  --quiz)
    _cmd_quiz "$2"
    ;;
  --undo)
    _cmd_undo "$2"
    ;;
  --workflow)
    _cmd_workflow "$2"
    ;;
  --start)
    _cmd_start
    ;;
  -*)
    printf "${YELLOW}Unknown option: $1${RESET}\n"
    printf "Usage: cheat [<topic>] [--list] [--home] [--start] [--quick <tool>] [--daily] [--quiz <topic>] [--undo <tool>] [--workflow <name>]\n"
    exit 1
    ;;
  *)
    file="$(_find_topic "$1")" && _render "$file" || {
      printf "\n${YELLOW}  No topic found for '${1}'.${RESET}\n\n"
      printf "  Available:\n"
      _list_all | sed "s|.*/|    ${YELLOW}|" | sed "s|$|${RESET}|"
      printf "\n"
      exit 1
    }
    ;;
esac
