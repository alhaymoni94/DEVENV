#!/usr/bin/env bash
# camp-progress — Show student progress through the camp

set -euo pipefail

CAMP_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"
STUDENT_DIR="$CAMP_DIR/students/$(whoami)"
TOTAL_PHASES=6

# Colors
GREEN="\033[32m"
CYAN="\033[1;36m"
YELLOW="\033[33m"
DIM="\033[2m"
RED="\033[31m"
RESET="\033[0m"
BOLD="\033[1m"

if [ ! -d "$STUDENT_DIR" ]; then
    echo -e "${RED}✗${RESET} Student directory not found: $STUDENT_DIR"
    echo -e "${DIM}Copy the template: cp -r students/template students/\$(whoami)${RESET}"
    exit 1
fi

echo -e "${CYAN}╔══════════════════════════════════════╗${RESET}"
echo -e "${CYAN}║   Camp Progress                      ║${RESET}"
echo -e "${CYAN}╚══════════════════════════════════════╝${RESET}"
echo ""

completed=0
total=0

for phase in $(seq 1 $TOTAL_PHASES); do
    phase_dir="$STUDENT_DIR/phase-$phase"
    material_dir="$CAMP_DIR/material/phase-$phase"
    lesson_count=0
    lesson_done=0

    # Count expected lessons from material
    if [ -d "$material_dir" ]; then
        for mat_lesson in "$material_dir"/lesson-*/; do
            if [ -d "$mat_lesson" ]; then
                lesson_name=$(basename "$mat_lesson")
                lesson_count=$((lesson_count + 1))
                total=$((total + 1))

                # Check if student has work in this lesson
                student_lesson="$phase_dir/$lesson_name"
                if [ -d "$student_lesson" ] && find "$student_lesson" -maxdepth 1 \( -name "*.py" -o -name "*.sh" -o -name "*.txt" -o -name "*.csv" -o -name "*.json" -o -name "*.yaml" -o -name "*.yml" -o -name "*.toml" -o -name "*.sql" -o -name "*.html" \) -print -quit 2>/dev/null | grep -q .; then
                    lesson_done=$((lesson_done + 1))
                    completed=$((completed + 1))
                    echo -e "  ${GREEN}✓${RESET} Phase $phase, Lesson $lesson_name"
                elif [ -d "$student_lesson" ]; then
                    echo -e "  ${DIM}○${RESET} Phase $phase, Lesson $lesson_name ${DIM}(started, no work files)${RESET}"
                else
                    echo -e "  ${DIM}○${RESET} Phase $phase, Lesson $lesson_name ${DIM}(not started)${RESET}"
                fi
            fi
        done
    fi

    if [ $lesson_count -eq 0 ]; then
        echo -e "  ${DIM}○${RESET} Phase $phase ${DIM}(no lessons defined)${RESET}"
    elif [ $lesson_done -eq $lesson_count ]; then
        echo -e "  ${GREEN}✓${RESET} Phase $phase ${GREEN}(complete)${RESET}"
    elif [ $lesson_done -gt 0 ]; then
        echo -e "  ${YELLOW}◐${RESET} Phase $phase ${YELLOW}($lesson_done/$lesson_count lessons)${RESET}"
    else
        echo -e "  ${DIM}○${RESET} Phase $phase ${DIM}($lesson_count lessons pending)${RESET}"
    fi
done

echo ""
if [ "$total" -gt 0 ]; then
    pct=$(( completed * 100 / total ))
else
    pct=0
fi
bar_len=30
filled=$(( pct * bar_len / 100 ))
empty=$(( bar_len - filled ))

printf "  Progress: ${GREEN}"
for ((i=0; i<filled; i++)); do printf "█"; done
printf "${DIM}"
for ((i=0; i<empty; i++)); do printf "░"; done
printf "${RESET} %d%%\n" "$pct"

echo ""
echo -e "  ${DIM}Completed: ${completed}/${total} lessons${RESET}"

# Check milestones
echo ""
echo -e "${CYAN}── Milestones ──${RESET}"

if bash "$CAMP_DIR/doctor.sh" 2>&1 | grep -q "40 passed"; then
    echo -e "  ${GREEN}✓${RESET} Setup complete (40/40 health)"
else
    echo -e "  ${RED}✗${RESET} Setup incomplete — run setup.sh"
fi

if [ $completed -ge 4 ]; then
    echo -e "  ${GREEN}✓${RESET} Phase 1 complete"
else
    echo -e "  ${DIM}○${RESET} Phase 1 complete ($completed/4 lessons)"
fi

if [ $completed -ge 7 ]; then
    echo -e "  ${GREEN}✓${RESET} Phase 2 complete"
else
    echo -e "  ${DIM}○${RESET} Phase 2 complete"
fi

if [ $completed -ge 10 ]; then
    echo -e "  ${GREEN}✓${RESET} Phase 3 complete"
else
    echo -e "  ${DIM}○${RESET} Phase 3 complete"
fi

if [ $completed -ge 13 ]; then
    echo -e "  ${GREEN}✓${RESET} Phase 4 complete"
else
    echo -e "  ${DIM}○${RESET} Phase 4 complete"
fi

if [ $completed -ge 17 ]; then
    echo -e "  ${GREEN}✓${RESET} Phase 5 complete"
else
    echo -e "  ${DIM}○${RESET} Phase 5 complete"
fi

if [ $completed -ge 18 ]; then
    echo -e "  ${GREEN}✓${RESET} Phase 6 complete — ready for graduation project!"
else
    echo -e "  ${DIM}○${RESET} Phase 6 complete"
fi

echo ""
