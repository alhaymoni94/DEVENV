#!/usr/bin/env bash
# camp-submit — Submit a phase for supervisor review
# Usage: camp-submit <phase-number>

set -euo pipefail

STUDENT_DIR="$HOME/students/$(whoami)"
PHASE="${1:?Usage: camp-submit <phase-number>}"

# Colors
GREEN="\033[32m"
CYAN="\033[1;36m"
YELLOW="\033[33m"
RED="\033[31m"
DIM="\033[2m"
RESET="\033[0m"

echo -e "${CYAN}── Submitting Phase $PHASE ──${RESET}"

# Check student directory exists
if [ ! -d "$STUDENT_DIR" ]; then
    echo -e "${RED}✗${RESET} Student directory not found: $STUDENT_DIR"
    echo -e "${DIM}Copy the template first: cp -r students/template students/\$(whoami)${RESET}"
    exit 1
fi

# Check phase directory exists
phase_dir="$STUDENT_DIR/phase-$PHASE"
if [ ! -d "$phase_dir" ]; then
    echo -e "${RED}✗${RESET} Phase $PHASE directory not found"
    exit 1
fi

# Check for work files
work_count=$(find "$phase_dir" -maxdepth 2 \( -name "*.py" -o -name "*.sh" -o -name "*.csv" -o -name "*.json" \) 2>/dev/null | wc -l)
if [ "$work_count" -eq 0 ]; then
    echo -e "${YELLOW}!${RESET} No work files found in phase $PHASE"
    read -rp "Submit anyway? [y/N] " ans
    if [[ "$ans" != "y" && "$ans" != "Y" ]]; then
        echo -e "${DIM}Submission cancelled.${RESET}"
        exit 0
    fi
fi

# Initialize git if needed
if [ ! -d "$STUDENT_DIR/.git" ]; then
    echo -e "${DIM}Initializing git repository...${RESET}"
    git init "$STUDENT_DIR"
fi

# Add and commit
cd "$STUDENT_DIR"
git add -A
git commit -m "submit: phase-$PHASE complete ($(date '+%Y-%m-%d'))"

echo ""
echo -e "${GREEN}✓${RESET} Phase $PHASE submitted!"
echo -e "${DIM}Your supervisor will review it. Run 'camp-progress' to check status.${RESET}"
