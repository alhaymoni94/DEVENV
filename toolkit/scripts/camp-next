#!/usr/bin/env bash
# camp-next — Show what the student should work on next

set -euo pipefail

CAMP_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"
STUDENT_DIR="$CAMP_DIR/students/$(whoami)"

# Colors
GREEN="\033[32m"
CYAN="\033[1;36m"
YELLOW="\033[33m"
DIM="\033[2m"
RESET="\033[0m"
BOLD="\033[1m"

if [ ! -d "$STUDENT_DIR" ]; then
    echo -e "${CYAN}╔══════════════════════════════════════╗${RESET}"
    echo -e "${CYAN}║   What's Next?                       ║${RESET}"
    echo -e "${CYAN}╚══════════════════════════════════════╝${RESET}"
    echo ""
    echo -e "${YELLOW}!${RESET} Student directory not found."
    echo ""
    echo -e "${DIM}Setup your workspace:${RESET}"
    echo -e "  ${GREEN}cp -r students/template students/\$(whoami)${RESET}"
    echo ""
    echo -e "${DIM}Then start with:${RESET}"
    echo -e "  ${GREEN}bash toolkit/setup.sh${RESET}"
    exit 0
fi

echo -e "${CYAN}╔══════════════════════════════════════╗${RESET}"
echo -e "${CYAN}║   What's Next?                       ║${RESET}"
echo -e "${CYAN}╚══════════════════════════════════════╝${RESET}"
echo ""

# Find the next incomplete lesson
next_found=false
for phase in $(seq 1 6); do
    phase_dir="$STUDENT_DIR/phase-$phase"
            material_dir="$CAMP_DIR/material/phase-$phase"

    if [ -d "$material_dir" ]; then
        for lesson_material in "$material_dir"/lesson-*/; do
            lesson_name=$(basename "$lesson_material")
            lesson_dir="$phase_dir/$lesson_name"

            if [ ! -d "$lesson_dir" ] || ! find "$lesson_dir" -maxdepth 1 \( -name "*.py" -o -name "*.sh" -o -name "*.csv" -o -name "*.json" \) -print -quit 2>/dev/null | grep -q .; then
                if ! $next_found; then
                    echo -e "${BOLD}Next: Phase $phase — $lesson_name${RESET}"
                    echo ""

                    # Show the lesson path
                    echo -e "${DIM}Lab file:${RESET}"
                    echo -e "  ${GREEN}cat material/phase-$phase/$lesson_name/student-lab.md${RESET}"
                    echo ""

                    # Show prerequisites
                    if [ "$phase" -gt 1 ]; then
                        echo -e "${DIM}Prerequisites:${RESET}"
                        echo -e "  Complete Phase $((phase - 1)) first"
                        echo ""
                    fi

                    # Show estimated time
                    echo -e "${DIM}Estimated time:${RESET}"
                    case $phase in
                        1) echo "  1.5 - 2 hours per lesson" ;;
                        2) echo "  1 - 2 hours per lesson" ;;
                        3) echo "  2 hours per lesson" ;;
                        4) echo "  2 hours per lesson" ;;
                        5) echo "  2 hours per lesson" ;;
                        6) echo "  2 hours" ;;
                    esac
                    echo ""

                    next_found=true
                fi
            fi
        done
    fi
done

if ! $next_found; then
    echo -e "${GREEN}✓${RESET} All phases complete!"
    echo ""
    echo -e "${BOLD}Next: Graduation Project${RESET}"
    echo ""
    echo -e "${DIM}See:${RESET}"
    echo -e "  ${GREEN}cat material/GRADUATION_PROJECT.md${RESET}"
fi

echo ""
